{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hc-gamer-life",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "images": {
    "binding": "IMAGES",
    "remote": true
  },
  "media": {
    "binding": "MEDIA",
    "remote": true
  },
  "stream": {
    "binding": "STREAM",
    "remote": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}


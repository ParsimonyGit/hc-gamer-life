# HighLevel Private Integration token for POST /api/quiz and purchase tags.
# Set as a Wrangler secret, never commit the real value:
#   npx wrangler secret put GHL_PIT
# Optional alias:
#   npx wrangler secret put HCGL_GHL_PIT
#
# Location ID defaults to STFgRxHbklvx2q1nDpi1 via wrangler.jsonc vars.
# GHL_PIT=
# HCGL_GHL_PIT=
# GHL_LOCATION_ID=STFgRxHbklvx2q1nDpi1

# Stripe Checkout (embedded_page) + webhook.
#   npx wrangler secret put STRIPE_SECRET_KEY
#   npx wrangler secret put STRIPE_WEBHOOK_SECRET
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=

# Parsimony ERP (ERPNext) at admin.hcgamerlife.org.
#   npx wrangler secret put ERP_API_KEY
#   npx wrangler secret put ERP_API_SECRET
# ERP_URL=https://admin.hcgamerlife.org
# ERP_API_KEY=
# ERP_API_SECRET=
# ERP_COMPANY=
# ERP_CUSTOMER_GROUP=All Customer Groups
# ERP_TERRITORY=All Territories
# ERP_ITEM_CODE=HCG1-PRO
# ERP_ITEM_RATE=129.99
# ERP_DRY_RUN=1
